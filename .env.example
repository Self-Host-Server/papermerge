conda_name=Papermerge

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
PAPERMERGE_SECRET_KEY=changeme-generate-your-own-secret-key

PAPERMERGE_ADMIN_USERNAME=admin
PAPERMERGE_ADMIN_PASSWORD=changeme

POSTGRES_USER=papermerge
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pmgdb

REDIS_PASSWORD=changeme

# OIDC / Authentik SSO -- optional. These values are only used if something
# actually initiates an OIDC login (e.g. a "Login with SSO" link); database
# auth keeps working either way, so leaving these as placeholders is harmless
# until you wire up SSO.
# Requires an OAuth2/OIDC Provider + Application already created on the
# Authentik side; these values come from that object, not from Authentik's
# issuer URL (papermerge uses explicit endpoint URLs, no discovery).
# Redirect URI to register in Authentik: <http|https>://<your domain>/oidc/callback
# Known gotcha: users provisioned via SSO are created with zero permissions
# (not superuser, no roles) -- grant access manually after their first login,
# or set PAPERMERGE_OIDC_DEFAULT_ROLE below.
PAPERMERGE_OIDC_CLIENT_ID=changeme
PAPERMERGE_OIDC_CLIENT_SECRET=changeme
PAPERMERGE_OIDC_ACCESS_TOKEN_URL=https://your-authentik-domain.example/application/o/token/
PAPERMERGE_OIDC_USER_INFO_URL=https://your-authentik-domain.example/application/o/userinfo/
PAPERMERGE_OIDC_INTROSPECT_URL=https://your-authentik-domain.example/application/o/introspect/
# Name of an existing Papermerge role to grant by default to SSO users who
# don't match any group/role claim from the provider. Set to empty to keep
# zero permissions by default (upstream behavior).
PAPERMERGE_OIDC_DEFAULT_ROLE=changeme
